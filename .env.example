# =============================================================================
# Truck Radar — variabili d'ambiente (esempio)
# Copia questo file in `.env.local` (o `.env`) e compila i valori.
# MAI committare file `.env` con segreti reali.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Self-hosted: puoi usare il Postgres di docker-compose (valore sotto).
# Cloud: stringa Supabase/Neon/RDS in modalità pooler.
DATABASE_URL="postgresql://truckradar:truckradar@localhost:5432/truckradar"

# -----------------------------------------------------------------------------
# Autenticazione (NextAuth v5 / Auth.js)
# -----------------------------------------------------------------------------
# Genera i segreti con: openssl rand -base64 32
AUTH_SECRET="sostituisci-con-un-segreto-casuale-lungo"
NEXTAUTH_SECRET="sostituisci-con-lo-stesso-valore-di-AUTH_SECRET"
# URL pubblico dell'app (usato per redirect, metadata, webhook di ritorno).
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Licenza self-hosted (Truck Radar)
# -----------------------------------------------------------------------------
# Metti `true` per attivare la verifica della licenza firmata (vedi docs/SELF_HOSTING.md).
# Se true e la licenza è assente/scaduta, l'app resta in trial (2 mezzi / 2 autisti).
TRUCK_RADAR_SELF_HOSTED="false"
# License key emessa con `npm run license:issue` (formato payload.firma base64url).
TRUCK_RADAR_LICENSE=""

# -----------------------------------------------------------------------------
# Upload file (UploadThing)
# -----------------------------------------------------------------------------
# Token base64 fornito dalla dashboard UploadThing (v7). Richiesto per KYC e DDT.
UPLOADTHING_TOKEN=""

# -----------------------------------------------------------------------------
# Stripe (abbonamenti SaaS — non usato in self-hosted)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID_BASE=""
STRIPE_PRICE_ID_PRO=""
# Verifica identità delegata a Stripe Identity (documento + selfie).
# Opzionale: in produzione è attiva di default se STRIPE_SECRET_KEY è presente.
# Imposta "false" per disattivarla esplicitamente.
STRIPE_IDENTITY_ENABLED=""

# -----------------------------------------------------------------------------
# Verifica identità/impresa (KYC/KYB) — opzionali
# -----------------------------------------------------------------------------
# Webhook KYC firmato (se configurato, la firma diventa obbligatoria in produzione).
KYC_WEBHOOK_SECRET=""
# AI per estrazione documenti KYB: Google Gemini (consigliato) e/o OpenAI.
GOOGLE_GENERATIVE_AI_API_KEY=""
KYB_AI_MODEL="gemini-3.1-flash-lite"
OPENAI_API_KEY=""
# Verifica ufficiale P.IVA (openapi.com Company, token OAuth Bearer).
OPENAPI_API_KEY=""

# -----------------------------------------------------------------------------
# Email e promemoria scadenze
# -----------------------------------------------------------------------------
# Provider Resend (https://resend.com). Se assente, gli avvisi restano in coda
# con stato NOT_CONFIGURED e sono visibili nella pagina Scadenze.
RESEND_API_KEY=""
EMAIL_FROM="Truck Radar <noreply@truck-radar.it>"
# Protegge /api/cron/deadlines. Imposta lo stesso valore nel cron Vercel.
CRON_SECRET=""

# -----------------------------------------------------------------------------
# Demo / sviluppo (non usare in produzione)
# -----------------------------------------------------------------------------
# Riquadro credenziali demo nella pagina di login.
NEXT_PUBLIC_SHOW_DEMO_CREDS="false"
# Riabilita il login degli account @demo.com anche in produzione (sconsigliato).
ALLOW_DEMO_LOGIN="false"
# Solo Docker: inserisce i dati demo (azienda/utenti demo) al primo avvio.
SEED_DEMO="false"
